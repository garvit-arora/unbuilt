# ---------- App ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Shows demo-account quick-login buttons on /auth and "Demo data" labels. Never enable on a real production deployment with real users.
NEXT_PUBLIC_DEMO_MODE=true

# ---------- Supabase (required) ----------
# `npx supabase start` prints these for the local stack.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- AI (optional; without it UNBUILT uses labelled deterministic fallbacks) ----------
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# json_object (default and recommended, widest compatibility) | json_schema (strict; falls back to json_object once on HTTP 400) | none
LLM_JSON_MODE=json_object
LLM_TIMEOUT_MS=30000
# Optional cost tracking, USD per 1M tokens
LLM_INPUT_COST_PER_MTOK=0.15
LLM_OUTPUT_COST_PER_MTOK=0.60

# Embeddings: defaults to LLM_BASE_URL / LLM_API_KEY when blank
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# 16..1536. Vectors shorter than 1536 are zero-padded for storage (cosine-preserving).
EMBEDDING_DIMENSIONS=1536
# Send the `dimensions` request parameter (OpenAI text-embedding-3 supports it; some providers reject it)
EMBEDDING_SEND_DIMENSIONS=true

# Matching thresholds (optional overrides; defaults in src/server/config/matching.ts).
# Run `npm run calibrate` after configuring an embedding model to get suggested values.
MATCH_JOIN_THRESHOLD_MODEL=
MATCH_REVIEW_THRESHOLD_MODEL=
MATCH_LLM_CONSIDER_THRESHOLD_MODEL=
MATCH_JOIN_THRESHOLD_LOCAL=
MATCH_REVIEW_THRESHOLD_LOCAL=
MATCH_LLM_CONSIDER_THRESHOLD_LOCAL=

# ---------- PayPal (required for checkout; app runs without it) ----------
PAYPAL_ENV=sandbox
# Production requires BOTH PAYPAL_ENV=live and PAYPAL_ALLOW_LIVE=true. Leave false.
PAYPAL_ALLOW_LIVE=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=USD
# Optional alias of PAYPAL_CLIENT_ID (public by design). The checkout reads PAYPAL_CLIENT_ID at runtime on the
# server and passes it to the PayPal button, so this value is not required; if set it must equal PAYPAL_CLIENT_ID.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Shown to buyers as the merchant of record
PAYPAL_MERCHANT_DISPLAY_NAME=UNBUILT Demo Merchant (PayPal Sandbox)

# ---------- Security ----------
# Salt for hashing anonymous client IPs in rate-limit keys (server only). Set a long random value in production.
RATE_LIMIT_SALT=

# ---------- Seed ----------
# Password for the three documented demo accounts created by `npm run seed`
DEMO_ACCOUNT_PASSWORD=UnbuiltDemo!2026
