# ---------- App ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Keep false for real users. Demo shortcuts are opt-in for isolated test environments only.
NEXT_PUBLIC_DEMO_MODE=false

# ---------- Supabase (required) ----------
# `npx supabase start` prints these for the local stack.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- AI (optional; without it UNBUILT uses labelled deterministic fallbacks) ----------
# Primary provider: tinker | openrouter | custom (legacy LLM_* endpoint)
LLM_PROVIDER=tinker
TINKER_BASE_URL=https://tinker.thinkingmachines.dev/services/tinker-prod/oai/api/v1
TINKER_API_KEY=
# A base model name or your tinker://.../sampler_weights/... checkpoint
TINKER_MODEL=thinkingmachines/Inkling
# Prompted JSON, checked against Zod; no unsupported response_format is sent.
TINKER_JSON_MODE=none
TINKER_INPUT_COST_PER_MTOK=
TINKER_OUTPUT_COST_PER_MTOK=

# Optional fallback; fill BOTH key and exact model ID to enable.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_JSON_MODE=json_object
OPENROUTER_INPUT_COST_PER_MTOK=
OPENROUTER_OUTPUT_COST_PER_MTOK=

# Used only when LLM_PROVIDER=custom. These are not Tinker credentials.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
# json_object (default and recommended, widest compatibility) | json_schema (strict; falls back to json_object once on HTTP 400) | none
LLM_JSON_MODE=json_object
LLM_TIMEOUT_MS=30000
LLM_MAX_TOKENS=4096
# Optional cost tracking, USD per 1M tokens
LLM_INPUT_COST_PER_MTOK=
LLM_OUTPUT_COST_PER_MTOK=

# Optional live market research for Make a wish. Tinker analyzes these results; it does not browse by itself.
# Create a server-side key at https://app.tavily.com and never prefix it with NEXT_PUBLIC_.
RESEARCH_BASE_URL=https://api.tavily.com
TAVILY_API_KEY=

# Optional resilient evidence index. If live search is unavailable, previous evidence is retrieved here.
ELASTICSEARCH_URL=
ELASTIC_API_KEY=
ELASTIC_RESEARCH_INDEX=unbuilt-research

# Embeddings: configure separately for Tinker; its chat key is never reused here.
# custom/openrouter primary providers can supply their own embedding defaults.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# 16..1536. Vectors shorter than 1536 are zero-padded for storage (cosine-preserving).
EMBEDDING_DIMENSIONS=1536
# Send the `dimensions` request parameter (OpenAI text-embedding-3 supports it; some providers reject it)
EMBEDDING_SEND_DIMENSIONS=true

# Matching thresholds (optional overrides; defaults in src/server/config/matching.ts).
# Run `npm run calibrate` after configuring an embedding model to get suggested values.
MATCH_JOIN_THRESHOLD_MODEL=
MATCH_REVIEW_THRESHOLD_MODEL=
MATCH_LLM_CONSIDER_THRESHOLD_MODEL=
MATCH_JOIN_THRESHOLD_LOCAL=
MATCH_REVIEW_THRESHOLD_LOCAL=
MATCH_LLM_CONSIDER_THRESHOLD_LOCAL=

# ---------- PayPal (required for checkout; app runs without it) ----------
PAYPAL_ENV=sandbox
# Production requires BOTH PAYPAL_ENV=live and PAYPAL_ALLOW_LIVE=true. Leave false.
PAYPAL_ALLOW_LIVE=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=USD
# Optional alias of PAYPAL_CLIENT_ID (public by design). The checkout reads PAYPAL_CLIENT_ID at runtime on the
# server and passes it to the PayPal button, so this value is not required; if set it must equal PAYPAL_CLIENT_ID.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Shown to buyers as the merchant of record
PAYPAL_MERCHANT_DISPLAY_NAME=UNBUILT

# ---------- Email reports (optional) ----------
# Server-only key from https://resend.com/api-keys. Never prefix it with NEXT_PUBLIC_.
RESEND_API_KEY=
# A sender address on a domain verified in Resend, e.g. reports@yourdomain.com
REPORT_FROM_EMAIL=

# ---------- Scheduled commitment refunds (required for unattended 30-day refunds) ----------
# Generate this yourself; it authenticates calls from your deployment scheduler.
CRON_SECRET=

# ---------- Security ----------
# Salt for hashing anonymous client IPs in rate-limit keys (server only). Set a long random value in production.
RATE_LIMIT_SALT=

# ---------- Seed ----------
# Password for the three documented demo accounts created by `npm run seed`
DEMO_ACCOUNT_PASSWORD=UnbuiltDemo!2026
