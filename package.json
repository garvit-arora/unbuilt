{
  "name": "unbuilt",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:start": "npx supabase start",
    "db:reset": "npx supabase db reset",
    "db:types": "supabase gen types typescript --local > src/server/db/types.ts",
    "db:env": "tsx scripts/write-local-env.ts",
    "seed": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/seed.ts",
    "reembed": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/reembed.ts",
    "calibrate": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/calibrate.ts",
    "check:env": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/check-env.ts"
  },
  "dependencies": {
    "@paypal/react-paypal-js": "^10.6.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@xyflow/react": "^12.12.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.70.0",
    "motion": "^14.10.1",
    "next": "^16.4.5",
    "radix-ui": "^1.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-is": "^19.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.5",
    "eslint-plugin-react": "^7.37.5",
    "shadcn": "^4.23.0",
    "supabase": "^3.0.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
